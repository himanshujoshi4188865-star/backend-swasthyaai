# Server Port
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated or * for all)
CORS_ORIGIN=*

# Gnani.ai Voice & Conversational AI API Keys
# Sign up at https://gnani.ai to obtain your production API credentials
GNANI_API_KEY=
GNANI_TOKEN=
GNANI_ACCESS_KEY=
GNANI_STT_URL=https://asr.gnani.ai/v1/recognize
GNANI_TTS_URL=https://tts.gnani.ai/v1/synthesize
GNANI_NLP_URL=https://nlp.gnani.ai/v1/intent

# Toggle fallback mode: if true, simulates voice when live API key is empty
GNANI_USE_MOCK_FALLBACK=true
